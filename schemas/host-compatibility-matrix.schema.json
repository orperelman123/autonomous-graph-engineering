{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/orperelman123/autonomous-graph-engineering/main/schemas/host-compatibility-matrix.schema.json",
  "title": "GraphVigil Host Compatibility Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "matrix", "scope", "hosts"],
  "properties": {
    "version": { "const": "1.0" },
    "matrix": { "const": "graphvigil-host-compatibility" },
    "scope": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "hosts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "allOf": [
        { "contains": { "type": "object", "properties": { "id": { "const": "codex" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "id": { "const": "claude" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "id": { "const": "cursor" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "id": { "const": "copilot" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "id": { "const": "hermes" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 }
      ],
      "items": { "$ref": "#/$defs/host" }
    }
  },
  "$defs": {
    "relativeEvidencePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "versionCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "testedVersions", "liveEvidence"],
      "properties": {
        "status": { "enum": ["contract-only", "live-tested"] },
        "testedVersions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "liveEvidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativeEvidencePath" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "contract-only" } } },
          "then": {
            "properties": {
              "testedVersions": { "type": "array", "maxItems": 0 },
              "liveEvidence": { "type": "array", "maxItems": 0 }
            }
          },
          "else": {
            "properties": {
              "testedVersions": { "type": "array", "minItems": 1 },
              "liveEvidence": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promptRefinement", "graphPlanning", "skills", "runtimeIdentity"],
      "properties": {
        "promptRefinement": { "const": "verified-by-repository" },
        "graphPlanning": { "const": "verified-by-repository" },
        "skills": { "const": "verified-by-repository" },
        "runtimeIdentity": { "const": "verified-by-repository" }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "integration", "promptReview", "versionCoverage", "capabilities", "evidence"],
      "properties": {
        "id": { "enum": ["codex", "claude", "cursor", "copilot", "hermes"] },
        "displayName": { "type": "string", "minLength": 1 },
        "integration": { "enum": ["plugin", "generated-config"] },
        "promptReview": { "enum": ["hook", "rule", "project-instructions"] },
        "versionCoverage": { "$ref": "#/$defs/versionCoverage" },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "evidence": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativeEvidencePath" }
        }
      }
    }
  }
}
